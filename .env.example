# Copy to .env (gitignored) and fill in. docker compose reads this file.

# Public URL the browser uses (scheme + host [+ port], no path -- this becomes CORS_ORIGINS, and a browser's own
# Origin header never includes a path). On the VM this is the shared deploy-gateway domain, no port of its own
# anymore (moved off :6367 onto /perf-agent -- see deploy-gateway's own nginx.conf/README).
PUBLIC_ORIGIN=http://localhost:8080
# Host port for the web UI on the VM.
WEB_PORT=8080

# Where deploy-gateway mounts this app's frontend. Baked into the built JS at image build time (Vite `base`) --
# changing it needs `docker compose up -d --build web`, AND a matching edit to apps/web/nginx.conf's own
# hardcoded /perf-agent/ locations (that file isn't templated). Leave unset to use the real deployed value, /perf-agent/.
VITE_BASE_PATH=

# API settings (passed to the api container via env_file).
LOG_LEVEL=info
MAX_UPLOAD_SIZE_MB=10
MAX_RUN_TIME_MS=1800000
JWT_EXPIRES_IN=12h
# REQUIRED. Startup refuses known-unsafe values when NODE_ENV=production.
JWT_SECRET=replace-with-output-of-openssl-rand-hex-48
ADMIN_USERNAME=admin
# REQUIRED. Must not be "admin".
ADMIN_PASSWORD=replace-with-a-strong-password
AUTH_DISABLED=0
